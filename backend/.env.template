# Public/storefront origins. Native Flutter clients are not constrained by browser CORS,
# but Flutter Web/local browser development is.
STORE_CORS=http://localhost:3000,http://localhost:8080
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:3000,http://localhost:8080

# Infrastructure
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sami_shope
REDIS_URL=redis://localhost:6379

# Replace these with long random secrets in every real environment.
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECRET=replace-with-a-long-random-secret
